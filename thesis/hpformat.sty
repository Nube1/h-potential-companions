% ============================================================
% hpformat.sty -- reusable chapter formatting for the H-potential thesis
% Implements the "Interdisciplinary Derivation Protocol" devices:
%   * an "At a glance" roadmap box (argument in outline, before equations)
%   * a "Reading" box for the domain translation after a result
%   * Seed / Junction / Perturbation / Stability labelled callouts
%   * inline equation-kind tags (definition / structural / consequence)
% The class already loads tcolorbox, xcolor, amsthm and thmtools.
% ============================================================
\ProvidesPackage{hpformat}[2026/09/02 H-potential chapter format]
\RequirePackage{booktabs}
\tcbuselibrary{skins,breakable}

% ---- roadmap box: the argument in outline, in plain words ----
\newtcolorbox{ataglance}[1][At a glance]{%
  breakable, enhanced, colback=black!3, colframe=black!55, boxrule=0.6pt,
  arc=2pt, left=9pt, right=9pt, top=7pt, bottom=7pt,
  title={#1}, fonttitle=\bfseries, coltitle=black, fontupper=\small}

% ---- reading box: what the equation means in the domain ----
\newtcolorbox{reading}[1][Reading]{%
  breakable, enhanced, colback=black!2, colframe=black!40,
  boxrule=0pt, leftrule=2.2pt, arc=0pt, left=9pt, right=9pt, top=4pt, bottom=4pt,
  title={#1}, fonttitle=\itshape, coltitle=black!60, fontupper=\small}

% ---- named step callouts (Seed / Junction / Perturbation / Stability) ----
\newcommand{\hpstep}[2]{\par\smallskip\noindent\textbf{\textsf{#1.}}\quad #2\par\smallskip}

% ---- inline equation-kind tags: print at the right of an equation line ----
\newcommand{\eqkind}[1]{\tag*{{\footnotesize\itshape\color{black!55}[#1]}}}
\newcommand{\kdef}{\eqkind{definition}}
\newcommand{\kstruct}{\eqkind{structural relation}}
\newcommand{\kcons}{\eqkind{consequence}}

% ---- a compact notation-table helper (optional) ----
\newenvironment{notationtable}[1][Notation and objects used in this chapter]{%
  \begin{table}[htbp]\centering\caption{#1}\small\begin{tabular}{p{2.4cm} p{3.2cm} p{7.2cm}}
  \toprule \textbf{Symbol} & \textbf{Name} & \textbf{Meaning / how it is read} \\ \midrule
}{%
  \bottomrule\end{tabular}\end{table}
}

% ============================================================
% V10 additions: worked examples with code, and verification
% pointers that name a test which actually exists and runs.
% ============================================================
\RequirePackage{listings}

% ---- restyle the class's workedexample environment as a framed box ----
% The class defines the counter, the environment and the List of Worked
% Examples. It renders as bare text, which is why worked examples were easy
% to skip past. This wraps the body in a rule so it reads as an object.
\let\hp@oldworkedexample\workedexample
\let\endhp@oldworkedexample\endworkedexample
\renewenvironment{workedexample}[2][]{%
  \par\medskip
  \refstepcounter{workedexample}%
  \addcontentsline{workedexample}{workedexample}{\protect\numberline{\theworkedexample}#2}%
  \ifx\relax#1\relax\else\label{ex:#1}\fi
  \begin{tcolorbox}[breakable, enhanced, sharp corners,
    colback=black!2, colframe=black!65, boxrule=0pt, leftrule=2.6pt,
    left=9pt, right=9pt, top=6pt, bottom=6pt,
    title={Worked Example \theworkedexample\quad #2},
    fonttitle=\bfseries\small, coltitle=black, colbacktitle=black!8,
    fontupper=\small]%
}{%
  \end{tcolorbox}\par\medskip
}

% ---- code block inside a worked example ----
\lstdefinestyle{hpcode}{
  basicstyle=\ttfamily\scriptsize,
  keywordstyle=\bfseries,
  commentstyle=\itshape\color{black!55},
  numbers=none, frame=none, breaklines=true,
  showstringspaces=false, columns=fullflexible,
  xleftmargin=6pt, aboveskip=4pt, belowskip=4pt,
}
\lstnewenvironment{wecode}[1][Python]
  {\lstset{style=hpcode,language=#1}}{}

% ---- the checked answer line that closes a worked example ----
\newcommand{\weanswer}[1]{%
  \par\smallskip\noindent
  \begingroup\raggedright\small
  $\blacktriangleright$\enspace\textbf{Answer.} #1\par\endgroup}

% ---- pointer to the test that asserts a result ----
% Replaces the V9 \volos macro, which announced test identifiers for tests
% that did not exist. \checkedby names a test in verification/ that runs.
\newcommand{\checkedby}[1]{%
  \par\smallskip\noindent
  {\footnotesize\itshape Verified numerically by
   \texttt{\detokenize{#1}} (Appendix~\ref{app:verification}).}\par\smallskip}
