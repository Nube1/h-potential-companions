% Minimal stand-in for har2nat.sty (CTAN), so the agsm Harvard style works
% under natbib where har2nat is not installed. Same macro names.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{har2nat}[2026/10/27 local stand-in]
\RequirePackage{natbib}
\providecommand\harvarditem[4][]{%
  \if\relax#1\relax\bibitem[#2(#3)]{#4}\else\bibitem[#1(#3)#2]{#4}\fi}
\providecommand\harvardand{\&}
\providecommand\harvardleft{(}
\providecommand\harvardright{)}
\providecommand\harvardyearleft{(}
\providecommand\harvardyearright{)}
\providecommand\harvardurl[1]{\textbf{URL:} \url{#1}}
\providecommand\citeasnoun{\citet}
\providecommand\possessivecite[1]{\citeauthor{#1}'s \citeyearpar{#1}}
\providecommand\citeaffixed[2]{\citep[#2][]{#1}}
\providecommand\citeyear{\citeyearpar}
\endinput
